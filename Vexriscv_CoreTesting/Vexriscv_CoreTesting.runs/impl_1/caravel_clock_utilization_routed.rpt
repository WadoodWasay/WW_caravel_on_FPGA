# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y3 [get_cells gpio_dm_reg[2]_i_1]
set_property LOC BUFGCTRL_X0Y2 [get_cells shift_register_reg[12]_i_1]
set_property LOC BUFGCTRL_X0Y0 [get_cells mprj_io_OBUF_BUFG[4]_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells hkspi_disable_reg_i_2]
set_property LOC BUFGCTRL_X0Y16 [get_cells clock_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y90 [get_cells mprj_io_OBUFT[4]_inst]

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports clock]

# Clock net "mprj_io_loader_strobe" driven by instance "gpio_dm_reg[2]_i_1" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_mprj_io_loader_strobe}
add_cells_to_pblock [get_pblocks  {CLKAG_mprj_io_loader_strobe}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="mprj_io_loader_strobe"}]]]
resize_pblock [get_pblocks {CLKAG_mprj_io_loader_strobe}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "mprj_io_loader_clock" driven by instance "shift_register_reg[12]_i_1" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_mprj_io_loader_clock}
add_cells_to_pblock [get_pblocks  {CLKAG_mprj_io_loader_clock}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="mprj_io_loader_clock"}]]]
resize_pblock [get_pblocks {CLKAG_mprj_io_loader_clock}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "mprj_io_OBUF_BUFG[4]" driven by instance "mprj_io_OBUF_BUFG[4]_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_mprj_io_OBUF_BUFG[4]}
add_cells_to_pblock [get_pblocks  {CLKAG_mprj_io_OBUF_BUFG[4]}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=mprj_io_OBUFT[4]_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="mprj_io_OBUF_BUFG[4]"}]]]
resize_pblock [get_pblocks {CLKAG_mprj_io_OBUF_BUFG[4]}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "housekeeping/csclk" driven by instance "hkspi_disable_reg_i_2" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_housekeeping/csclk}
add_cells_to_pblock [get_pblocks  {CLKAG_housekeeping/csclk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="housekeeping/csclk"}]]]
resize_pblock [get_pblocks {CLKAG_housekeeping/csclk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "clock_IBUF_BUFG" driven by instance "clock_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
